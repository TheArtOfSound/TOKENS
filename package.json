{
  "name": "qira-ledger",
  "private": false,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && cp dist/index.html dist/404.html && node scripts/prerender-routes.mjs && node scripts/seo.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "join": "tsx collector/join.ts",
    "collect": "tsx collector/collectV2.ts",
    "scan:debug": "tsx collector/scanDebug.ts",
    "validate:data": "tsx collector/validateLatest.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:noop": "node -e \"process.stdout.write('npm spawn ok')\"",
    "consent": "tsx collector/consent.ts show",
    "consent:preview": "tsx collector/consent.ts preview",
    "consent:export": "tsx collector/consent.ts export",
    "consent:delete": "tsx collector/consent.ts delete",
    "verify": "tsx collector/verify.ts",
    "ingest": "tsx collector/ingest.ts",
    "key": "tsx collector/key.ts",
    "import": "tsx collector/import.ts",
    "identity": "tsx collector/identity.ts",
    "publish:serve": "tsx publish/server.ts",
    "publish:migrate": "tsx publish/migrate-static.ts",
    "publish:ledger": "tsx collector/publishLedgerUnavailable.ts",
    "publish:ledger:dev": "tsx collector/publishLedger.ts",
    "dev:all": "tsx publish/server.ts & vite",
    "list-me": "tsx collector/listMeSetup.ts",
    "list-me:core": "tsx collector/listMe.ts",
    "unlist": "tsx collector/unlist.ts",
    "build:cli": "node scripts/build-cli.mjs",
    "prepublishOnly": "npm run build:cli"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "ajv": "8.20.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "3.2.7"
  },
  "description": "Measure your AI-assisted work locally, sign it on your device, and publish a record anyone can verify.",
  "author": "Qira LLC",
  "homepage": "https://ledger.imagineqira.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheArtOfSound/TOKENS.git"
  },
  "bugs": {
    "url": "https://github.com/TheArtOfSound/TOKENS/issues"
  },
  "keywords": [
    "ai",
    "claude",
    "codex",
    "grok",
    "kimi",
    "gemini",
    "usage",
    "evidence",
    "provenance",
    "verifiable",
    "local-first",
    "cli"
  ],
  "bin": {
    "ledger": "dist-cli/ledger.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "dist-cli/",
    "README.md",
    "LICENSE"
  ],
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
