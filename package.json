{
  "name": "qira-agent-usage-observatory",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "collect": "tsx collector/collectV2.ts",
    "scan:debug": "tsx collector/scanDebug.ts",
    "validate:data": "tsx collector/validateLatest.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "consent": "tsx collector/consent.ts show",
    "consent:preview": "tsx collector/consent.ts preview",
    "consent:export": "tsx collector/consent.ts export",
    "consent:delete": "tsx collector/consent.ts delete",
    "verify": "tsx collector/verify.ts",
    "ingest": "tsx collector/ingest.ts",
    "key": "tsx collector/key.ts"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "ajv": "8.20.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "3.2.7"
  }
}
