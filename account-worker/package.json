    "db:migrate:local": "wrangler d1 migrations apply ledger-account --local",
    "db:migrate:remote": "wrangler d1 migrations apply ledger-account --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260808.1",
    "typescript": "6.0.3",
    "vitest": "3.2.7",
    "wrangler": "4.120.0"
  }
}
