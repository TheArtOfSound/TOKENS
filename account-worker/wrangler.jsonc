{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ledger-account",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ledger.imagineqira.com/api/*",
      "zone_name": "imagineqira.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ledger-account",
      "database_id": "01936732-440e-4dde-9594-4bf807f05450",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
